# RagTool Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration (Required if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Google/Gemini Configuration (Required if using Google models)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Note: EMBEDDINGS_GOOGLE_API_KEY will be auto-set from GOOGLE_API_KEY or GEMINI_API_KEY
# But you can set it explicitly if needed:
# EMBEDDINGS_GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration (Optional - defaults provided)
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_MAX_TOKENS=1024

# Embedding Configuration (Optional - defaults provided)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# File Paths (Optional - defaults provided)

DATA_FILE_PATH=./data/raw/Sap_Cloud_platform.pdf

CHROMA_DB_PATH=./db

# API Security (Optional - for production)
API_KEY=your_secure_api_key_for_production


# LangSmith Monitoring & Debugging (Optional)
# Get your API key from https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=sap-rag-tool-dev
LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # Optional: custom endpoint

# Railway Configuration (Set automatically by Railway)
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_SERVICE_NAME=ragtool
# RAILWAY_PROJECT_ID=your_project_id
# PORT=8001