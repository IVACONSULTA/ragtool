{
  "dashboard_config": {
    "project_name": "sap-rag-tool-dev",
    "description": "SapRagTool LLM Monitoring Dashboard",
    "version": "1.0.0",
    "created_at": "2024-01-01T00:00:00Z"
  },
  "monitoring_metrics": {
    "cost_tracking": {
      "enabled": true,
      "metrics": [
        "total_cost",
        "daily_costs",
        "cost_by_model",
        "average_cost_per_call",
        "input_tokens_cost",
        "output_tokens_cost"
      ],
      "alerts": {
        "daily_budget_exceeded": {
          "threshold": 10.0,
          "enabled": true
        },
        "high_cost_per_call": {
          "threshold": 0.1,
          "enabled": true
        }
      }
    },
    "performance_tracking": {
      "enabled": true,
      "metrics": [
        "total_calls",
        "error_rate",
        "average_latency",
        "response_times",
        "model_usage",
        "error_types"
      ],
      "alerts": {
        "high_error_rate": {
          "threshold": 0.05,
          "enabled": true
        },
        "slow_response": {
          "threshold": 30.0,
          "enabled": true
        }
      }
    },
    "token_tracking": {
      "enabled": true,
      "metrics": [
        "total_tokens",
        "input_tokens",
        "output_tokens",
        "tokens_by_model",
        "average_tokens_per_call"
      ]
    }
  },
  "dashboard_widgets": [
    {
      "id": "cost_overview",
      "title": "Cost Overview",
      "type": "metric",
      "position": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "config": {
        "metrics": ["total_cost", "daily_costs"],
        "chart_type": "line",
        "time_range": "7d"
      }
    },
    {
      "id": "token_usage",
      "title": "Token Usage",
      "type": "metric",
      "position": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "config": {
        "metrics": ["total_tokens", "tokens_by_model"],
        "chart_type": "bar",
        "time_range": "7d"
      }
    },
    {
      "id": "model_usage",
      "title": "Model Usage",
      "type": "pie",
      "position": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "config": {
        "metrics": ["calls_by_model", "cost_by_model"],
        "time_range": "7d"
      }
    },
    {
      "id": "performance_metrics",
      "title": "Performance Metrics",
      "type": "metric",
      "position": { "x": 4, "y": 4, "w": 8, "h": 4 },
      "config": {
        "metrics": ["average_latency", "error_rate", "total_calls"],
        "chart_type": "line",
        "time_range": "24h"
      }
    },
    {
      "id": "error_analysis",
      "title": "Error Analysis",
      "type": "table",
      "position": { "x": 0, "y": 8, "w": 12, "h": 4 },
      "config": {
        "metrics": ["error_types", "error_rate_by_model"],
        "time_range": "7d"
      }
    }
  ],
  "alerts": [
    {
      "name": "Daily Budget Exceeded",
      "condition": "daily_costs > 10.0",
      "severity": "high",
      "enabled": true,
      "notification": {
        "email": true,
        "webhook": false
      }
    },
    {
      "name": "High Error Rate",
      "condition": "error_rate > 0.05",
      "severity": "medium",
      "enabled": true,
      "notification": {
        "email": true,
        "webhook": false
      }
    },
    {
      "name": "Slow Response Time",
      "condition": "average_latency > 30.0",
      "severity": "low",
      "enabled": true,
      "notification": {
        "email": false,
        "webhook": false
      }
    }
  ],
  "export_settings": {
    "formats": ["json", "csv", "excel"],
    "schedule": "daily",
    "retention_days": 30
  }
}
