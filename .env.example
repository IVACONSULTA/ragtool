# RagTool Configuration Example
# Copy this file to .env and customize for your environment

# =============================================================================
# CONFIGURATION SET SELECTION
# =============================================================================
# Choose your configuration set by setting CONFIG_SET
# Available options: GEMINI_2.0_FLASH, GEMINI_2.5_FLASH, OPENAI_4o_MINI,
#                    GROQ_LLAMA__LIGHT_MODEL, GROQ_LLAMA__MODEL,
#                    GROQ_MIXTRAL_MODEL, MISTRAL_LARGE_MODEL
CONFIG_SET=OPENAI_4o_MINI

# Configuration Set Details:
# - GEMINI_2.0_FLASH: Google Gemini 2.0 Flash (2048 tokens, Google provider)
# - GEMINI_2.5_FLASH: Google Gemini 2.5 Flash (4096 tokens, Google provider)
# - OPENAI_4o_MINI: OpenAI GPT-4o-mini (1024 tokens, OpenAI provider)
# - GROQ_LLAMA__LIGHT_MODEL: Groq Llama 3.1 8B Instant (1024 tokens, Groq provider)
# - GROQ_LLAMA__MODEL: Groq Llama 3.1 70B Versatile (1024 tokens, Groq provider)
# - GROQ_MIXTRAL_MODEL: Groq Mixtral 8x7B (1024 tokens, Groq provider)
# - MISTRAL_LARGE_MODEL: Mistral Large 2411 via OpenRouter (4096 tokens, OpenRouter provider)

# =============================================================================
# REQUIRED API KEYS
# =============================================================================
# OpenAI API Key (required for OPENAI_4o_MINI and embedding models)
OPENAI_API_KEY=your-openai-api-key-here

# Google API Key (required for GEMINI_2.0_FLASH and GEMINI_2.5_FLASH configurations)
# Uncomment the line below if using Gemini configurations
# GEMINI_API_KEY=your-google-api-key-here

# Groq API Key (required for GROQ_* configurations)
# Uncomment the line below if using Groq configurations
# GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API Key (required for MISTRAL_LARGE_MODEL configuration)
# Uncomment the line below if using Mistral Large via OpenRouter
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# =============================================================================
# OPTIONAL OVERRIDES
# =============================================================================
# The following variables will override the defaults from your chosen CONFIG_SET

# LLM Configuration Overrides
# LLM_MODEL=gpt-4o
# LLM_PROVIDER=openai
# LLM_MAX_TOKENS=4096
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_PROVIDER=openai

# Path Configuration Overrides
# DATA_FILE_PATH=./custom/path/to/file.pdf
# CHROMA_DB_PATH=./custom/chromadb/path

# =============================================================================
# EXAMPLES
# =============================================================================

# Example 1: Use OpenAI GPT-4o-mini (default)
# CONFIG_SET=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key

# Example 2: Use Google Gemini Pro
# CONFIG_SET=gemini-pro
# GEMINI_API_KEY=your-google-api-key
