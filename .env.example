# RagTool Configuration Example
# Copy this file to .env and customize for your environment

# =============================================================================
# CONFIGURATION SET SELECTION
# =============================================================================
# Choose your configuration set by setting CONFIG_SET
# Available options: gpt-4o-mini, gemini-pro
CONFIG_SET=gpt-4o-mini

# Configuration Set Details:
# - gpt-4o-mini: OpenAI GPT-4o-mini (1024 tokens, OpenAI provider)
# - gemini-pro:  Google Gemini Pro (2048 tokens, Google provider)

# =============================================================================
# REQUIRED API KEYS
# =============================================================================
# OpenAI API Key (required for gpt-4o-mini configuration)
OPENAI_API_KEY=your-openai-api-key-here

# Google API Key (required for gemini-pro configuration)
# Uncomment the line below if using gemini-pro
# GEMINI_API_KEY=your-google-api-key-here

# =============================================================================
# OPTIONAL OVERRIDES
# =============================================================================
# The following variables will override the defaults from your chosen CONFIG_SET

# LLM Configuration Overrides
# LLM_MODEL=gpt-4o
# LLM_PROVIDER=openai
# LLM_MAX_TOKENS=4096
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_PROVIDER=openai

# Path Configuration Overrides
# DATA_FILE_PATH=./custom/path/to/file.pdf
# CHROMA_DB_PATH=./custom/chromadb/path

# =============================================================================
# EXAMPLES
# =============================================================================

# Example 1: Use OpenAI GPT-4o-mini (default)
# CONFIG_SET=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key

# Example 2: Use Google Gemini Pro
# CONFIG_SET=gemini-pro
# GEMINI_API_KEY=your-google-api-key
